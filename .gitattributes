# Normalise line endings: text is stored with LF in the repository and checked out per platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.ico binary
*.wav binary
*.woff binary
*.woff2 binary
*.node binary
*.exe binary

# Recorded API fixtures are byte-for-byte responses.
tests/fixtures/** -text

# Keep the lockfile out of diffs and language stats.
package-lock.json -diff linguist-generated
