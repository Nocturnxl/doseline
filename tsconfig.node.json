{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/core/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.live.config.mts"
  ]
}
